{
  "name": "claude-code-orchestrator",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "sync-agents": "tsx src/sync-agents.ts",
    "check-agents": "tsx src/sync-agents.ts --check",
    "native": "scripts/orchestrate.sh",
    "auto": "scripts/auto.sh",
    "route": "tsx src/route.ts",
    "report": "node scripts/report.mjs",
    "build-plugin": "node scripts/build-plugin.mjs",
    "check-plugin": "node scripts/build-plugin.mjs --check",
    "compare": "node scripts/compare/compare.mjs",
    "compare:validate": "node scripts/compare/compare.mjs --validate",
    "compare:hard": "node scripts/compare/compare.mjs --tasks h1-query-engine,h2-scheduler --variants C,A,D,B",
    "compare:mutate": "node scripts/compare/mutate.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
