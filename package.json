{
  "name": "claude-code-orchestration",
  "version": "2.1.1",
  "description": "Native orchestrator for Claude Code (the main toolkit: agents, hooks, skills and a workflow, shipped as a plugin; npm start), plus the older, frozen SDK pipeline for code in git (npm run sdk).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "claude --agent orchestrator --plugin-dir dist/dashboard",
    "orchestrate": "claude --agent orchestrator --plugin-dir dist/dashboard",
    "native": "scripts/orchestrate.sh",
    "auto": "scripts/auto.sh",
    "plain": "claude --settings '{\"agent\":\"\",\"outputStyle\":\"Concise\"}'",
    "route": "tsx src/route.ts",
    "report": "node scripts/report.mjs",
    "sdk": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check.mjs",
    "test": "node scripts/run-tests.mjs",
    "sync-agents": "tsx src/sync-agents.ts",
    "check-agents": "tsx src/sync-agents.ts --check",
    "build-plugin": "node scripts/build-plugin.mjs",
    "check-plugin": "node scripts/build-plugin.mjs --check",
    "test-dashboard": "node scripts/test-dashboard.mjs",
    "install-statusline": "bash scripts/install-statusline.sh",
    "claude-update": "node scripts/claude-update.mjs",
    "skill-publish": "node scripts/skill-publish.mjs",
    "soak": "node scripts/soak-gates.mjs",
    "bench": "node bench/run.mjs",
    "bench:validate": "node bench/validate.mjs",
    "bench:grade": "node bench/grade.mjs",
    "bench:analyze": "node bench/analyze.mjs",
    "bench:report": "node bench/report.mjs",
    "eval": "claude plugin eval dist/plugin --scaffold --trust-plugin --no-publish --max-cost-usd 10 --threshold 0 --json evals-result.json --allow-tools Bash Write Edit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.331"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
