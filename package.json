{
  "name": "claude-code-orchestration",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run check-agents && npm run check-plugin",
    "test": "tsx --test src/*.test.ts src/*.test.mjs && node --test bench/*.test.mjs",
    "sync-agents": "tsx src/sync-agents.ts",
    "check-agents": "tsx src/sync-agents.ts --check",
    "native": "scripts/orchestrate.sh",
    "auto": "scripts/auto.sh",
    "route": "tsx src/route.ts",
    "report": "node scripts/report.mjs",
    "build-plugin": "node scripts/build-plugin.mjs",
    "check-plugin": "node scripts/build-plugin.mjs --check",
    "orchestrate": "claude --agent orchestrator --plugin-dir dist/dashboard",
    "test-dashboard": "node scripts/test-dashboard.mjs",
    "bench": "node bench/run.mjs",
    "bench:validate": "node bench/validate.mjs",
    "bench:grade": "node bench/grade.mjs",
    "bench:analyze": "node bench/analyze.mjs",
    "bench:report": "node bench/report.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
